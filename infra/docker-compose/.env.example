# EIP local dev stack — example environment (TASK-0003). Copy to `.env` and adjust if needed.
# These are NON-PRODUCTION dev placeholders. NEVER put real secrets here or in `.env` (git-ignored).

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=eip
POSTGRES_PASSWORD=eip_dev_pw
POSTGRES_DB=eip
POSTGRES_PORT=5432

# --- Redis 7 ---
REDIS_PORT=6379

# --- Kafka (KRaft) --- host listener on 29092, in-network on 9092
KAFKA_PORT=29092

# --- MinIO (S3) --- canonical buckets: eip-artifacts, eip-ingest
MINIO_ROOT_USER=eip_minio
MINIO_ROOT_PASSWORD=eip_minio_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_ARTIFACTS=eip-artifacts
S3_BUCKET_INGEST=eip-ingest

# --- Keycloak --- HTTP on 8180 (path /auth), health/mgmt on 9010->9000
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pw
KEYCLOAK_PORT=8180
KEYCLOAK_MGMT_PORT=9010

# --- Observability ---
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_pw
