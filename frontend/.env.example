# EIP frontend — local dev/demo environment template. Copy to `.env.development` (git-ignored), or
# just run `make demo-up`, which injects these for you. NOT used in production builds — production
# resolves the tenant via OIDC, never a default.

# The fixed demo tenant seeded by the backend `demo` profile (DemoDataSeeder.DEMO_TENANT_ID) — lets
# the UI load without querying Postgres for a tenant id.
VITE_EIP_TENANT_ID=00000000-0000-4000-8000-0000000000de

# Where the Vite dev server proxies /api and /v3 (the eip-app). Defaults to this if unset.
VITE_API_PROXY_TARGET=http://localhost:8080
