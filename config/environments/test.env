# EIP install config — test (functional test environment).
SPRING_PROFILES_ACTIVE=test
VITE_MODE=test
FRONTEND_SERVE=dev
COMPOSE_PROFILES=core,observability
EIP_BACKEND_PORT=8080
VITE_PORT=5173
SEEDED=1                    # test seeds the demo dataset (profile group test -> demo)
EIP_SECURITY_MODE=header    # header resolution until OIDC lands in this environment (DEBT-012)
# Deployment-level OIDC claim-name overrides (DEBT-012 residual, EipOidcClaimProperties) — NOT
# per-tenant (see that class's javadoc). Defaults shown; uncomment only to test a non-default mapping.
#EIP_SECURITY_OIDC_TENANT_CLAIM=eip_tenant
#EIP_SECURITY_OIDC_ROLES_CLAIM=realm_access.roles
# Pagination-cursor HMAC signing key (DEBT-010, ApiCursorSigningProperties) — same dev fixture as
# dev.env; a real deployment overrides this.
EIP_API_CURSOR_SIGNING_KEY=RUlQLURFVi1PTkxZLUNVUlNPUi1TSUdOLUtFWS0zMiE=
