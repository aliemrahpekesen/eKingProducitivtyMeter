# EIP install config — dev (developer laptop). Loaded by scripts/install/install.{sh,ps1}; every
# value can be overridden from the shell (shell env > this file > compose defaults).
SPRING_PROFILES_ACTIVE=dev
VITE_MODE=development
FRONTEND_SERVE=dev          # dev = vite dev server (hot reload)
COMPOSE_PROFILES=core,observability
EIP_BACKEND_PORT=8080
VITE_PORT=5173
SEEDED=1                    # dev seeds the demo dataset (profile group dev -> demo)
EIP_SECURITY_MODE=header    # dev/demo convenience (X-EIP-Tenant); set to oidc to exercise SSO
                             # against the Compose Keycloak (see the demo SSO users install.sh prints)
# Deployment-level OIDC claim-name overrides (DEBT-012 residual, EipOidcClaimProperties) — NOT
# per-tenant (see that class's javadoc for the chicken-and-egg reason). Defaults shown; uncomment
# and change only if your IdP maps the tenant/roles claims under different names.
#EIP_SECURITY_OIDC_TENANT_CLAIM=eip_tenant
#EIP_SECURITY_OIDC_ROLES_CLAIM=realm_access.roles
# Pagination-cursor HMAC signing key (DEBT-010, ApiCursorSigningProperties) — dev fixture, the same
# well-known DEV-ONLY value application.yaml defaults to; a real deployment overrides this.
EIP_API_CURSOR_SIGNING_KEY=RUlQLURFVi1PTkxZLUNVUlNPUi1TSUdOLUtFWS0zMiE=
