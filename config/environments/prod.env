# EIP install config — prod. This file is configuration-complete (DEBT-012, M5 Wave S1a: OIDC
# tenant resolution + deny-by-default RBAC have landed), but every CHANGE_ME below must be replaced
# before prod will boot — ProductionTenantResolutionGuard refuses startup unless
# EIP_SECURITY_MODE=oidc AND EIP_OIDC_ISSUER is a real (non-blank, non-CHANGE_ME) issuer, so
# header/demo tenant resolution can never serve production traffic. scripts/install/install.sh
# still refuses `--env prod` outright (it is a one-command LOCAL install tool; a real prod
# deployment is not a local `docker compose up`) — this file documents the real deployment's shape.
# Secret-bearing values follow the CHANGE_ME convention (DEBT-005) — a real deployment replaces
# every CHANGE_ME via its secret manager; nothing real is ever committed.
SPRING_PROFILES_ACTIVE=prod
VITE_MODE=production
FRONTEND_SERVE=preview
COMPOSE_PROFILES=core,observability
EIP_BACKEND_PORT=8080
VITE_PORT=5173
SEEDED=0
EIP_DB_URL=CHANGE_ME
EIP_APP_DB_USER=CHANGE_ME
EIP_APP_DB_PASSWORD=CHANGE_ME
EIP_MIGRATOR_DB_USER=CHANGE_ME
EIP_MIGRATOR_DB_PASSWORD=CHANGE_ME
EIP_SECURITY_MODE=oidc
# Operator must point this at the enterprise IdP realm (e.g. https://idp.example.com/realms/eip);
# prod refuses to boot while this is CHANGE_ME.
EIP_OIDC_ISSUER=CHANGE_ME
