# EIP install config — prod. INTENTIONALLY NOT LOCALLY BOOTABLE in this release: OIDC tenant
# resolution is not implemented yet (DEBT-012) and ProductionTenantResolutionGuard refuses startup
# so header/demo tenant resolution can never serve production traffic. The installer explains this
# and exits. Secret-bearing values follow the CHANGE_ME convention (DEBT-005) — a real deployment
# replaces every CHANGE_ME via its secret manager; nothing real is ever committed.
SPRING_PROFILES_ACTIVE=prod
VITE_MODE=production
FRONTEND_SERVE=preview
COMPOSE_PROFILES=core,observability
EIP_BACKEND_PORT=8080
VITE_PORT=5173
SEEDED=0
EIP_DB_URL=CHANGE_ME
EIP_APP_DB_USER=CHANGE_ME
EIP_APP_DB_PASSWORD=CHANGE_ME
EIP_MIGRATOR_DB_USER=CHANGE_ME
EIP_MIGRATOR_DB_PASSWORD=CHANGE_ME
