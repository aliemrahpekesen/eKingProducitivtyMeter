{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Engineering Intelligence Platform API",
    "description" : "REST /api/v1 surface. Team-level engineering intelligence; no individual developer metrics (NFR-071).",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/session" : {
      "get" : {
        "tags" : [ "session-controller" ],
        "operationId" : "session",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/friction/summary" : {
      "get" : {
        "tags" : [ "friction-controller" ],
        "operationId" : "summary",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FrictionSummaryView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connectors" : {
      "get" : {
        "tags" : [ "connector-controller" ],
        "operationId" : "connectors",
        "parameters" : [ {
          "name" : "cursor",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageViewConnectorView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "SessionView" : {
        "type" : "object",
        "properties" : {
          "tenantId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "organizationName" : {
            "type" : "string"
          }
        }
      },
      "FrictionMetricView" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "purpose" : {
            "type" : "string"
          },
          "formula" : {
            "type" : "string"
          },
          "inputs" : {
            "$ref" : "#/components/schemas/JsonNode"
          },
          "grain" : {
            "type" : "string"
          },
          "caveats" : {
            "type" : "string"
          },
          "gamingRisks" : {
            "type" : "string"
          }
        }
      },
      "FrictionSummaryView" : {
        "type" : "object",
        "properties" : {
          "metric" : {
            "$ref" : "#/components/schemas/FrictionMetricView"
          },
          "metricVersion" : {
            "type" : "string"
          },
          "computedAt" : {
            "type" : "string"
          },
          "simulation" : {
            "type" : "boolean"
          },
          "teams" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TeamFrictionView"
            }
          },
          "teamsReporting" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "JsonNode" : {
        "type" : "object"
      },
      "TeamFrictionView" : {
        "type" : "object",
        "properties" : {
          "teamId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "teamName" : {
            "type" : "string"
          },
          "frictionScore" : {
            "type" : "integer",
            "format" : "int32"
          },
          "dominantCause" : {
            "type" : "string"
          },
          "workItems" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalCycleSec" : {
            "type" : "integer",
            "format" : "int64"
          },
          "activeSec" : {
            "type" : "integer",
            "format" : "int64"
          },
          "waitingSec" : {
            "type" : "integer",
            "format" : "int64"
          },
          "blockedSec" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reviewWaitSec" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reworkCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "flowEfficiencyPct" : {
            "type" : "integer",
            "format" : "int32"
          },
          "blockedPct" : {
            "type" : "integer",
            "format" : "int32"
          },
          "reviewWaitPct" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "ConnectorView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "simulation" : {
            "type" : "boolean"
          }
        }
      },
      "PageViewConnectorView" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ConnectorView"
            }
          },
          "nextCursor" : {
            "type" : "string"
          },
          "hasMore" : {
            "type" : "boolean"
          }
        }
      }
    }
  }
}